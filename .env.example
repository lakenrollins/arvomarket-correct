# Copy to .env. Everything is optional: with no keys the app runs in SIMULATION mode.
JWT_SECRET=change-me
# AI copywriting (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Email (any SMTP provider: Gmail app password, SendGrid, Resend SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Arvo Market <you@yourdomain.com>"
# SMS (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Address used in password-reset emails (change when you deploy)
APP_URL=http://localhost:5173
# Production only
NODE_ENV=production
DATA_DIR=/data
# Free AI option (no card): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
